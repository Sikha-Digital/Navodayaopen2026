# ========================================================
# Navodaya Open 2026 - Environment Configuration
# ========================================================

# Neon DB Connection String (PostgreSQL)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Server Port
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# Optional Admin Security Key for accessing GET /api/registrations
ADMIN_KEY=navodaya_admin_secret_2026

# ========================================================
# Automatic Confirmation Email Configuration (SMTP)
# ========================================================
# Option A: Gmail (Requires App Password: https://myaccount.google.com/apppasswords)
# SMTP_SERVICE=gmail
# SMTP_USER=your_tournament_email@gmail.com
# SMTP_PASS=your_16_character_app_password

# Option B: Standard SMTP / Resend / SendGrid / Custom SMTP Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_password_or_api_key

# Sender display name & address
EMAIL_FROM="Navodaya Open 2026" <noreply@navodayaopen.com>

# Optional: Admin email to receive BCC copy of every registration confirmation
# ADMIN_EMAIL=organizers@navodayaopen.com
